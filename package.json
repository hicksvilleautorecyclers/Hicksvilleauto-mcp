{
  "name": "hicksvilleauto-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hicks Help: public HAR inventory and Duramax knowledge for ChatGPT and MCP clients.",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env.local dist/src/index.js",
    "dev": "npm run build && npm start",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
