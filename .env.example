# Use ONLY the same publishable key as the public HAR website. Never a secret/service-role key.
HAR_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
HAR_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Stable deployed origin; no path. Local development defaults to http://localhost:3333.
HAR_MCP_ORIGIN=http://localhost:3333
PORT=3333
